<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Resize grip template -->
	<Button name="GearRackTrinketsResizeTemplate" virtual="true">
		<Size>
			<AbsDimension x="16" y="16"/>
		</Size>
		<NormalTexture file="Interface\AddOns\GearRack\media\Trinket-Buttons" setAllPoints="true">
			<TexCoords left=".75" right=".875" top="0" bottom=".125"/>
		</NormalTexture>
		<HighlightTexture file="Interface\AddOns\GearRack\media\Trinket-Buttons" alphaMode="ADD" setAllPoints="true">
			<TexCoords left=".75" right=".875" top="0" bottom=".125"/>
		</HighlightTexture>
		<Scripts>
			<OnLoad>
if GearRack.enabled then

				this:SetFrameLevel(this:GetFrameLevel()+2)

end
</OnLoad>
			<OnMouseDown>
if GearRack.enabled then

				GearRackTrinkets.StartScaling()

end
</OnMouseDown>
			<OnMouseUp>
if GearRack.enabled then

				GearRackTrinkets.StopScaling()

end
</OnMouseUp>
		</Scripts>
	</Button>

	<!-- Worn trinkets template -->
	<CheckButton name="GearRackTrinketsMainTrinketTemplate" inherits="ActionButtonTemplate" virtual="true">
		<Scripts>
			<OnLoad>
if GearRack.enabled then

				this:RegisterForClicks("LeftButtonUp","RightButtonUp")

end
</OnLoad>
			<OnClick>
if GearRack.enabled then

				GearRackTrinkets.MainTrinket_OnClick()

end
</OnClick>
			<OnEnter>
if GearRack.enabled then

				GearRackTrinkets.BuildMenu()
				GearRackTrinkets.WornTrinketTooltip()

end
</OnEnter>
			<OnLeave>
if GearRack.enabled then

				GearRackTrinkets.ClearTooltip()

end
</OnLeave>
		</Scripts>
	</CheckButton>

	<!-- Menu trinkets template -->
	<CheckButton name="GearRackTrinketsMenuTrinketTemplate" inherits="ActionButtonTemplate" virtual="true">
		<Scripts>
			<OnLoad>
if GearRack.enabled then

				this:RegisterForClicks("LeftButtonUp","RightButtonUp")

end
</OnLoad>
			<OnClick>
if GearRack.enabled then

